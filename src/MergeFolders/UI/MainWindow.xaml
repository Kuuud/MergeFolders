<Window x:Class="MergeFolders.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="合并文件夹" Height="690" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock FontSize="22" FontWeight="SemiBold" Text="合并文件夹"/>
      <TextBlock Margin="0,5,0,12" Foreground="#666">支持 Windows 本地路径、网络盘和 rclone mount 路径。</TextBlock>
    </StackPanel>

    <Border Grid.Row="1" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock FontWeight="Bold" Text="源文件夹（多选）"/>
        <ListBox x:Name="SourceList" Grid.Row="1" Margin="0,8,0,12"/>
        <Grid Grid.Row="2" Margin="0,0,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center" Text="目标文件夹：" Margin="0,0,8,0"/>
          <TextBox x:Name="DestinationText" Grid.Column="1" Height="30"/>
          <Button Grid.Column="2" Content="选择..." Click="ChooseDestination_Click"/>
        </Grid>
        <Grid Grid.Row="3">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <GroupBox Header="同名文件" Margin="0,0,8,0" Padding="8">
            <StackPanel>
              <RadioButton x:Name="FileAsk" Content="每次询问" IsChecked="True"/>
              <RadioButton x:Name="FileOverwrite" Content="覆盖"/>
              <RadioButton x:Name="FileSkip" Content="跳过"/>
              <RadioButton x:Name="FileRename" Content="自动重命名"/>
            </StackPanel>
          </GroupBox>
          <GroupBox Grid.Column="1" Header="同名文件夹" Margin="4,0,4,0" Padding="8">
            <StackPanel>
              <RadioButton x:Name="DirMerge" Content="合并（推荐）" IsChecked="True"/>
              <RadioButton x:Name="DirSkip" Content="跳过"/>
              <RadioButton x:Name="DirRename" Content="自动重命名"/>
            </StackPanel>
          </GroupBox>
          <GroupBox Grid.Column="2" Header="操作" Margin="8,0,0,0" Padding="8">
            <StackPanel>
              <RadioButton x:Name="CopyMode" Content="合并复制" IsChecked="True"/>
              <RadioButton x:Name="MoveMode" Content="合并移动"/>
              <CheckBox x:Name="PreserveTime" Content="保留时间" IsChecked="True" Margin="0,8,0,0"/>
              <CheckBox x:Name="DeleteEmpty" Content="移动成功后删除空源文件夹"/>
            </StackPanel>
          </GroupBox>
        </Grid>
        <Grid Grid.Row="4" Margin="0,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center" Text="复制后校验：" Margin="0,0,8,0"/>
          <ComboBox x:Name="VerificationCombo" Width="150" HorizontalAlignment="Left" SelectedIndex="0">
            <ComboBoxItem Content="不校验" Tag="None"/>
            <ComboBoxItem Content="文件大小" Tag="Size"/>
            <ComboBoxItem Content="SHA-256" Tag="Sha256"/>
          </ComboBox>
        </Grid>
      </Grid>
    </Border>

    <StackPanel Grid.Row="2" Margin="0,14,0,8">
      <ProgressBar x:Name="Progress" Height="12" Minimum="0" Maximum="100"/>
      <TextBlock x:Name="StatusText" Margin="0,6,0,0" Foreground="#666" Text="准备就绪"/>
    </StackPanel>

    <DockPanel Grid.Row="3">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <Button Content="取消" Click="Cancel_Click"/>
        <Button Content="开始合并" FontWeight="SemiBold" Click="Start_Click"/>
      </StackPanel>
      <TextBlock VerticalAlignment="Center" Foreground="#777" Text="提示：同名文件夹默认递归合并；文件冲突可覆盖、跳过或重命名。"/>
    </DockPanel>
  </Grid>
</Window>
